# Expo SDK 57+ installs its own native `fetch` by default, whose responses
# (`FetchResponse`) only implement the `Response` TS interface — they are
# NOT `instanceof` the real `Response` class RN's whatwg-fetch polyfill
# installs. openapi-fetch's middleware contract (see core/api/client.ts)
# requires a genuine `Response` instance, so revert to RN's real fetch.
# The flag itself is read in expo/src/winter/runtime.native.ts.
EXPO_PUBLIC_USE_RN_FETCH=1
