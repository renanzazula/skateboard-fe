# `openapi-typescript@7` declares a peer of `typescript@^5.x`, and this project
# is on TypeScript 6. The range is just conservative — codegen and `tsc` both
# run fine — but npm's strict peer resolution treats it as fatal, so a clean
# `npm ci` dies with ERESOLVE.
#
# Local installs only ever worked because of a hand-typed `--legacy-peer-deps`.
# EAS Build runs `npm ci` with no such flag and reads this file instead, so
# without it every iOS/Android build fails in the "Install dependencies" phase.
#
# Revisit when openapi-typescript widens its peer range to include TS 6; it is
# a devDependency used only to regenerate src/core/api/generated/schema.ts, so
# nothing it resolves reaches the shipped bundle.
legacy-peer-deps=true
